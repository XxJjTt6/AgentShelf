digraph AgentShelfArchitecture {
  graph [
    rankdir=LR,
    bgcolor="#fff8e7",
    pad="0.35",
    nodesep="0.42",
    ranksep="0.75",
    splines=ortho,
    fontname="PingFang SC"
  ];
  node [
    shape=box,
    style="filled",
    color="#111111",
    penwidth=2.4,
    margin="0.15,0.10",
    fontname="PingFang SC",
    fontsize=12
  ];
  edge [
    color="#111111",
    penwidth=1.8,
    arrowsize=0.7,
    fontname="PingFang SC",
    fontsize=10
  ];

  subgraph cluster_input {
    label="输入资料";
    color="#111111";
    penwidth=2.2;
    style="filled";
    fillcolor="#ffffff";
    csv [label="商品 CSV", fillcolor="#feca57"];
    image [label="商品图片", fillcolor="#48dbfb"];
    policy [label="政策与认证", fillcolor="#ff9ff3"];
  }

  console [label="Web 操作台\nNext.js + React", fillcolor="#1dd1a1", width=1.55];

  subgraph cluster_core {
    label="AgentShelf 核心服务";
    color="#111111";
    penwidth=2.2;
    style="filled";
    fillcolor="#ffffff";
    passport [label="Product Passport\n来源 / 冲突 / 未知项 / 版本", fillcolor="#feca57"];
    listing [label="本地化 Listing\n平台 / 市场 / 语言", fillcolor="#48dbfb"];
    preflight [label="发布前检查\n格式 / 来源 / 商业状态", fillcolor="#ff9ff3"];
    redteam [label="Agent 红队引擎\n30 个任务 / 12 个故障", fillcolor="#ff6b6b"];
    repair [label="修复与同场景复测\n新版本 + 结构化差异", fillcolor="#1dd1a1"];
    approval [label="人工确认\n内容 / 价格 / 库存 / 配送", fillcolor="#feca57"];
  }

  subgraph cluster_ai {
    label="AI 能力（受结构约束）";
    color="#111111";
    penwidth=2.2;
    style="dashed,filled";
    fillcolor="#fff0ad";
    qwen [label="Qwen\n图片与政策理解\nListing 组织\n语义复核", fillcolor="#ffffff"];
  }

  subgraph cluster_rules {
    label="固定安全控制";
    color="#111111";
    penwidth=2.2;
    style="filled";
    fillcolor="#baf7e6";
    rules [label="Zod 结构校验\n平台规则\n金额与状态核对\n版本与放行条件", fillcolor="#ffffff"];
  }

  subgraph cluster_sandbox {
    label="商业沙箱与协议";
    color="#111111";
    penwidth=2.2;
    style="filled";
    fillcolor="#bceefa";
    commerce [label="5 个商品 API\n搜索 / 商品 / 配送\n购物车 / 模拟结账", fillcolor="#ffffff"];
    protocol [label="UCP / ACP / MCP\n能力映射", fillcolor="#ffffff"];
  }

  output [label="发布文件与测试证据\nListing / Feed / JSON-LD\nManifest / 报告", fillcolor="#ff9ff3", width=1.85];

  csv -> console;
  image -> console;
  policy -> console;
  console -> passport;
  passport -> listing;
  listing -> preflight;
  preflight -> redteam;
  redteam -> repair [label="失败"];
  repair -> redteam [label="同场景复测"];
  redteam -> approval [label="通过"];
  approval -> output;

  qwen -> passport [style=dashed, label="结构化建议"];
  qwen -> listing [style=dashed];
  qwen -> redteam [style=dashed];
  rules -> passport;
  rules -> preflight;
  rules -> redteam;
  commerce -> redteam;
  commerce -> approval;
  protocol -> commerce [dir=both];
}

