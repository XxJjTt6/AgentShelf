# 阿里云百炼 API Key。只保存在本机 .env.local，切勿提交到仓库。
DASHSCOPE_API_KEY=

# 官方兼容端点。若已知业务空间 ID，优先替换为业务空间专属地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 截至 2026-08 官方最新旗舰模型，支持图文输入、工具调用和结构化输出。
DASHSCOPE_MODEL=qwen3.8-max

# 可选：前端允许用户切换的模型白名单，使用英文逗号分隔。
DASHSCOPE_MODEL_OPTIONS=qwen3.8-max,qwen3-max,qwen-plus,qwen-flash

# 可选：用于签名模拟购物车报价。生产环境必须使用高强度随机值。
COMMERCE_SANDBOX_SECRET=replace-with-a-random-sandbox-secret
